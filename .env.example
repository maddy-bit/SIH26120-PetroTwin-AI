# Copy to .env for local Docker Compose. Replace the example password before use.
# Use URL-safe letters and numbers so Compose can form DATABASE_URL safely.
POSTGRES_USER=petrotwin
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_DB=petrotwin
# Host ports can be changed if the defaults are already in use.
API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
# Default is fail-closed field mode. Set to simulation only for synthetic development data.
PETROTWIN_DATA_MODE=field
# Match the frontend origin if FRONTEND_HOST_PORT changes.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Authentication is disabled only for local development and isolated test fixtures.
PETROTWIN_AUTH_MODE=disabled
# Required in production: generate a unique 48-byte secret; never commit it.
# PETROTWIN_JWT_SECRET=
PETROTWIN_TOKEN_TTL_MINUTES=15
# Optional OpenAI-compatible chat-completions provider. Use a local endpoint or hosted service.
# Agent execution remains disabled until both BASE_URL and MODEL are provided.
PETROTWIN_AGENT_BASE_URL=
# Keep provider keys in your secret manager or protected .env; never commit.
# PETROTWIN_AGENT_API_KEY=
PETROTWIN_AGENT_MODEL=
PETROTWIN_AGENT_TIMEOUT_SECONDS=60
PETROTWIN_AGENT_MAX_TOOL_CALLS=8
# Persistent directory for approved measured-data model artifacts (mounted volume in Compose).
PETROTWIN_FIELD_MODEL_ARTIFACT_DIR=

# PETRO-TWIN AI FastAPI / physics / ML service
# Update the pinned digest only after dependency and vulnerability review.
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    OMP_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2 \
    MKL_NUM_THREADS=2 \
    NUMEXPR_NUM_THREADS=2 \
    HOME=/tmp

WORKDIR /app

# Install only runtime dependencies. Python wheels are used for the pinned ML stack.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements-prod.lock ./requirements-prod.lock
RUN python -m pip install --no-cache-dir -r requirements-prod.lock

COPY physics/ ./physics/
COPY config/ ./config/
COPY data/sources/ ./data/sources/
COPY agent/ ./agent/
COPY mcp_server/ ./mcp_server/
COPY ml_service/ ./ml_service/
COPY tests/ ./tests/
COPY scripts/ ./scripts/

# The only application write target in production is the dedicated model-artifact volume.
RUN mkdir -p /app/ml_service/saved_models/field /app/data \
    && groupadd --system --gid 10001 petrotwin \
    && useradd --system --uid 10001 --gid 10001 --home-dir /app --shell /usr/sbin/nologin petrotwin \
    && chown -R 10001:10001 /app/ml_service/saved_models /app/data

USER 10001:10001

EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=25s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3)"

CMD ["uvicorn", "ml_service.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
